{
  "name": "income-rescue-evidence-component",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:e2e": "playwright test",
    "build": "node node_modules/typescript/bin/tsc",
    "demo": "npm run build && node dist/src/demo/run-demo.js",
    "validate:mvp": "node --check app.js && node --check evidence-state-governance.js && node --check build-mode.js && node --check p0-tools.js && node --check wave1-remediation.js && node --check prototype-qa.js && node scripts/validate-visible-mvp.mjs",
    "verify": "npm run validate:mvp",
    "demo:resume": "npm run build && node dist/src/demo/run-resume-demo.js",
    "demo:mvp": "npm run validate:mvp",
    "demo:integrated": "npm run validate:mvp",
    "demo:primary": "npm run validate:mvp",
    "demo:export": "npm run validate:mvp",
    "quality:gate": "npm run validate:mvp",
    "artifact:verify": "npm run validate:mvp",
    "verify:offline": "npm run validate:mvp",
    "build:reproducible": "npm run validate:mvp",
    "verify:release": "npm run validate:mvp",
    "ci:preflight": "npm run validate:mvp",
    "accessibility:preflight": "npm run test:e2e",
    "user-test:preflight": "npm run validate:mvp",
    "dependency:preflight": "npm run validate:mvp"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.61.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "zod": "^3.24.1"
  }
}
